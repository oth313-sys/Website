# Copy to .env for local development. On Vercel these are set in Project → Settings → Environment Variables.

# Postgres connection string (Vercel's Neon integration sets this automatically).
POSTGRES_URL=postgres://user:password@host:5432/database

# Any long random string. Keep it secret.
PAYLOAD_SECRET=change-me

# Vercel Blob token for image uploads (set automatically when a Blob store is connected).
BLOB_READ_WRITE_TOKEN=
